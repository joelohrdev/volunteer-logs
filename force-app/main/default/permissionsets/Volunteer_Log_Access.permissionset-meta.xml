<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Volunteer Log Access</label>
    <description>Read/write access to Volunteer_Log__c and its fields. Custom fields deployed via the Metadata API have no field-level security for any profile, so this is required for the controller's USER_MODE queries and stripInaccessible calls to see anything.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Volunteer_Log__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Volunteer_Log__c.Activity_Date__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Volunteer_Log__c.Hours__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Volunteer_Log__c.Notes__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Volunteer_Log__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <classAccesses>
        <apexClass>VolunteerLogController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
